---
title: System Architecture - Red Teaming Engine
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#E2E8F0"
    clusterBorder: "#94A3B8"
---
flowchart LR
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef danger   fill:#EF4444,stroke:#1E293B,color:#ffffff,stroke-width:1px;

    Goals[(Goal suite)]:::data
    Mutators[(Mutator registry)]:::data

    subgraph Search["Evolutionary search"]
        Population[Population of attacks]:::core
        Fitness[Fitness: evasion and comprehension]:::core
        Variation[Crossover and mutation]:::core
    end

    subgraph Target["System under test"]
        Guard{{Guard: naive or hardened}}:::danger
        Model[Model comprehension]:::core
    end

    Report[Attack success rate report]:::core

    Goals --> Population
    Mutators --> Variation
    Population --> Fitness
    Fitness -->|score each attack| Target
    Guard -->|detection| Fitness
    Model -->|comprehension| Fitness
    Fitness --> Variation
    Variation --> Population
    Population -->|best attacks| Report
