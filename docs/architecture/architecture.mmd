flowchart TD
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client(["HTTP client"]):::edge
    CLI(["CLI<br/>report | attack | serve"]):::edge

    subgraph Interfaces["Interfaces (stdlib HTTP, stateless)"]
        direction TB
        Router["Router<br/>/health | /ready | /report | /attack"]:::core
        Validate["Request validation<br/>known goal, seed bound, hardened flag"]:::control
    end

    subgraph Bundled["Bundled data (fictional, read-only)"]
        direction TB
        Goals[("Goal suite<br/>5 fictional terms, guard thresholds")]:::data
        Mutators[("Mutator registry<br/>7 transforms, evasion + cost")]:::data
    end

    subgraph Search["Attack search (seeded, deterministic)"]
        direction TB
        Evo["Evolutionary search<br/>population 16, 20 generations"]:::core
        Baselines["Baselines<br/>direct, best single mutator"]:::core
        Fitness["Fitness ranking<br/>success bonus, else threshold deficits"]:::core
        Variation["Crossover + mutation<br/>insert, delete, replace"]:::core
    end

    subgraph Target["System under test (simulated)"]
        direction TB
        Guard{{"Guard<br/>naive or hardened"}}:::control
        Model["Model comprehension<br/>threshold 0.5"]:::core
        Outcome["Attack outcome<br/>evades guard and stays understood"]:::core
    end

    subgraph Eval["Evaluation and observability"]
        direction TB
        Report["Attack success rate report<br/>4 strategies over the suite"]:::obs
        Result["Attack result<br/>mutated prompt, simulated response"]:::obs
        Metrics["Route metrics<br/>Prometheus GET /metrics"]:::obs
    end

    Client -->|JSON request| Router
    Router -->|POST /attack| Validate
    Validate -->|goal, seed, hardened| Evo
    Router -->|GET /report| Baselines
    CLI -->|attack or report| Evo
    Goals -.->|goal lookup| Validate
    Goals -.->|goal suite| Baselines
    Mutators -.->|gene pool| Evo
    Evo -->|population| Fitness
    Fitness -->|survivors| Variation
    Variation -->|next generation| Evo
    Fitness -->|candidate attack| Guard
    Fitness -->|candidate attack| Model
    Baselines -->|fixed attacks| Guard
    Mutators -.->|evasion profiles| Guard
    Guard -->|detection score| Outcome
    Model -->|comprehension score| Outcome
    Outcome -.->|fitness signal| Fitness
    Outcome -->|success per goal| Report
    Outcome -->|best attack| Result
    Router -.-> Metrics
