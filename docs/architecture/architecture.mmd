flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        CLI["CLI<br/>report, attack, serve"]:::edge
        Client(["HTTP client"]):::edge
        Router["HTTP router<br/>/report /attack"]:::core
        Validate["Validation<br/>goal, seed, hardened"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph Search["Attack search (seeded)"]
        direction TB
        Baselines["Baselines<br/>direct, single mutator"]:::core
        Evo["Evolutionary search<br/>16 attacks, 20 gens"]:::core
        Fitness["Fitness ranking<br/>success, else deficits"]:::core
        Variation["Crossover + mutation<br/>insert, delete, replace"]:::core
        Baselines ~~~ Evo --> Fitness --> Variation
    end

    subgraph Data["Bundled data"]
        direction TB
        Goals[("Goal suite<br/>5 fictional terms")]:::data
        Mutators[("Mutator registry<br/>7 transforms")]:::data
        Goals ~~~ Mutators
    end

    subgraph Target["System under test"]
        direction TB
        Guard{{"Guard<br/>naive or hardened"}}:::control
        Model["Model comprehension<br/>threshold 0.5"]:::core
        Outcome["Attack outcome<br/>evaded and understood"]:::core
        Model ~~~ Guard --> Outcome
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Report["Attack success rate<br/>4 strategies"]:::obs
        Result["Attack result<br/>prompt + response"]:::obs
        Metrics["Route metrics<br/>Prometheus text"]:::obs
        Report ~~~ Result ~~~ Metrics
    end

    Interfaces -->|goal, seed, mode| Search
    Search -->|candidate attacks| Target
    Data -.->|goals, mutators| Search
    Search -->|best attack per goal| Obs
